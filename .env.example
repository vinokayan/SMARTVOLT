APP_NAME=SmartVolt
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================================
# DATABASE
# ============================================================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartvolt
DB_USERNAME=root
DB_PASSWORD=

# Gunakan 3307 apabila MySQL/XAMPP Anda berjalan pada port 3307.
# DB_PORT=3307

# ============================================================================
# SESSION, CACHE, DAN QUEUE
# ============================================================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=smartvolt_

QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ============================================================================
# REDIS
# ============================================================================

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# ============================================================================
# EMAIL
# ============================================================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@smartvolt.local"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================================
# GOOGLE LOGIN
# Jangan masukkan kredensial asli ke file .env.example.
# Kredensial asli hanya ditempatkan di file .env.
# ============================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ============================================================================
# SMARTVOLT IOT API
# Pastikan nama variabel ini sesuai dengan config/services.php.
# ============================================================================

IOT_API_KEY=
IOT_ONLINE_TIMEOUT_MINUTES=2

# ============================================================================
# MQTT
# ============================================================================

MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# Sebaiknya dibiarkan tidak ditentukan agar setiap proses MQTT mendapatkan
# client ID berbeda. Hal ini mencegah listener terputus ketika website
# membuka koneksi MQTT lain.
# MQTT_CLIENT_ID=smartvolt-laravel

MQTT_CLEAN_SESSION=true
MQTT_ENABLE_LOGGING=true
MQTT_LOG_CHANNEL=null

MQTT_AUTH_USERNAME=
MQTT_AUTH_PASSWORD=

MQTT_CONNECT_TIMEOUT=10
MQTT_SOCKET_TIMEOUT=5
MQTT_RESEND_TIMEOUT=10
MQTT_KEEP_ALIVE_INTERVAL=10

MQTT_AUTO_RECONNECT_ENABLED=true
MQTT_AUTO_RECONNECT_MAX_RECONNECT_ATTEMPTS=10
MQTT_AUTO_RECONNECT_DELAY_BETWEEN_RECONNECT_ATTEMPTS=3

# ============================================================================
# MQTT LAST WILL
# Kosongkan pada Laravel karena Last Will utama dikirim oleh ESP32.
# ============================================================================

MQTT_LAST_WILL_TOPIC=
MQTT_LAST_WILL_MESSAGE=
MQTT_LAST_WILL_QUALITY_OF_SERVICE=0
MQTT_LAST_WILL_RETAIN=false

# ============================================================================
# MQTT TLS
# Gunakan false untuk pengembangan lokal.
# Aktifkan TLS ketika SmartVolt digunakan melalui jaringan publik.
# ============================================================================

MQTT_TLS_ENABLED=false
MQTT_TLS_ALLOW_SELF_SIGNED_CERT=false
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_VERIFY_PEER_NAME=true
MQTT_TLS_CA_FILE=
MQTT_TLS_CA_PATH=
MQTT_TLS_CLIENT_CERT_FILE=
MQTT_TLS_CLIENT_CERT_KEY_FILE=
MQTT_TLS_CLIENT_CERT_KEY_PASSPHRASE=
MQTT_TLS_ALPN=

# ============================================================================
# AWS
# ============================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================================
# FRONTEND
# ============================================================================

VITE_APP_NAME="${APP_NAME}"